%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
name: RISC-V Assembly
file_extensions:
  - s
  - S
  - riscv
scope: source.riscv

variables:
  identifier: '[a-zA-Z_.][a-zA-Z0-9_.]*'
  dec_int: '[0-9]+'
  hex_int: '0x[0-9a-fA-F]+'
  bin_int: '0b[01]+'
  number: '(?:{{dec_int}}|{{hex_int}}|{{bin_int}})'

contexts:
  main:
    - include: comment
    - include: directives
    - include: labels
    - include: registers
    - include: instructions
    - include: strings
    - include: numbers
    - include: punctuation

  comment:
    - match: '#.*$'
      scope: comment.line.number-sign.riscv

  directives:
    - match: '^\.(?:section|text|data|global|string|asciz|word|half|byte|align|zero)\b'
      scope: keyword.control.directive.riscv

  labels:
    - match: '^{{identifier}}(?=:)'
      scope: entity.name.function.label.riscv
    - match: ':'
      scope: punctuation.definition.label.riscv

  registers:
    # Integer registers
    - match: '\b(?:x([0-9]|[12][0-9]|3[01])|zero|ra|sp|gp|tp|t([0-6])|s([0-9]|1[01])|a([0-7]))\b'
      scope: variable.other.register.riscv
    # Alternative names for better readability
    - match: '\b(fp|lr|ip)\b'   # some assemblers use these aliases
      scope: variable.other.register.riscv

  instructions:
    # RV32I base instructions
    - match: '\b(?:lui|auipc|jal|jalr|beq|bne|blt|bge|bltu|bgeu|lb|lh|lw|lbu|lhu|sb|sh|sw|addi|slti|sltiu|xori|ori|andi|slli|srli|srai|add|sub|sll|slt|sltu|xor|srl|sra|or|and|fence|fence\.i|ecall|ebreak|unimp)\b'
      scope: keyword.other.instruction.riscv
    # Pseudo‑instructions (common)
    - match: '\b(?:la|li|mv|not|neg|seqz|snez|sltz|sgtz|beqz|bnez|blez|bgez|bltz|bgtz|j|jr|ret|call|tail|nop)\b'
      scope: keyword.other.pseudo.riscv

  strings:
    - match: '"(?:\\.|[^"\\])*"'
      scope: string.quoted.double.riscv

  numbers:
    - match: '\b{{number}}\b'
      scope: constant.numeric.riscv

  punctuation:
    - match: '[(),]'
      scope: punctuation.separator.riscv